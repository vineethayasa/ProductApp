@page
@model WebApp.Pages.IndexModel

<style>

    .page-container {
        width: 90%;
        max-width: 1100px;
        margin: 40px auto;
        text-align: center;
    }

    .add-product-form {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
        margin-bottom: 30px;
    }

    .add-product-form input {
        width: 200px;
        padding: 8px;
        box-sizing: border-box;
    }

    .add-product-form button {
        padding: 8px 15px;
    }

    .product-table {
        width: 100%;
        table-layout: fixed;
        border-collapse: collapse;
        margin: 0 auto;
    }

    .product-table th,
    .product-table td {
        border: 1px solid #ccc;
        padding: 10px;
        text-align: center;
        box-sizing: border-box;
    }

    /*
       Keep each column the same width whether
       displaying text or editing.
    */

    .id-column {
        width: 8%;
    }

    .name-column {
        width: 20%;
    }

    .description-column {
        width: 32%;
    }

    .price-column {
        width: 15%;
    }

    .actions-column {
        width: 25%;
    }

    .edit-input {
        width: 100%;
        box-sizing: border-box;
        padding: 6px;
    }

    .action-form {
        display: inline;
    }

    .action-button {
        padding: 6px 12px;
        margin: 2px;
    }

</style>


<div class="page-container">

    <h1>Products</h1>


    <!-- ADD PRODUCT -->

    <form method="post"
          asp-page-handler="Create"
          class="add-product-form">

        <input type="text"
               name="name"
               placeholder="Name"
               required />

        <input type="text"
               name="description"
               placeholder="Description"
               required />

        <input type="number"
               name="price"
               placeholder="Price"
               step="0.01"
               required />

        <button type="submit">
            Add Product
        </button>

    </form>


    <!-- PRODUCT LIST -->

    @if (Model.Products.Count == 0)
    {
        <p>No products found.</p>
    }
    else
    {
        <table class="product-table">

            <thead>
                <tr>

                    <th class="id-column">
                        Id
                    </th>

                    <th class="name-column">
                        Name
                    </th>

                    <th class="description-column">
                        Description
                    </th>

                    <th class="price-column">
                        Price
                    </th>

                    <th class="actions-column">
                        Actions
                    </th>

                </tr>
            </thead>


            <tbody>

            @foreach (var product in Model.Products)
            {
                <tr>

                    <!-- ID -->

                    <td>
                        @product.Id
                    </td>


                    <!-- NAME -->

                    <td>

                        <span id="display-name-@product.Id">
                            @product.Name
                        </span>

                        <input id="edit-name-@product.Id"
                               class="edit-input"
                               type="text"
                               value="@product.Name"
                               style="display:none;" />

                    </td>


                    <!-- DESCRIPTION -->

                    <td>

                        <span id="display-description-@product.Id">
                            @product.Description
                        </span>

                        <input id="edit-description-@product.Id"
                               class="edit-input"
                               type="text"
                               value="@product.Description"
                               style="display:none;" />

                    </td>


                    <!-- PRICE -->

                    <td>

                        <span id="display-price-@product.Id">
                            @product.Price
                        </span>

                        <input id="edit-price-@product.Id"
                               class="edit-input"
                               type="number"
                               value="@product.Price"
                               step="0.01"
                               style="display:none;" />

                    </td>


                    <!-- ACTIONS -->

                    <td>

                        <button type="button"
                                id="edit-button-@product.Id"
                                class="action-button"
                                onclick="editProduct(@product.Id)">
                            Edit
                        </button>


                        <form method="post"
                              asp-page-handler="Update"
                              id="update-form-@product.Id"
                              class="action-form"
                              style="display:none;">

                            <input type="hidden"
                                   name="id"
                                   value="@product.Id" />

                            <input type="hidden"
                                   name="name"
                                   id="form-name-@product.Id" />

                            <input type="hidden"
                                   name="description"
                                   id="form-description-@product.Id" />

                            <input type="hidden"
                                   name="price"
                                   id="form-price-@product.Id" />

                            <button type="submit"
                                    class="action-button">
                                Save
                            </button>

                        </form>


                        <form method="post"
                              asp-page-handler="Delete"
                              asp-route-id="@product.Id"
                              class="action-form">

                            <button type="submit"
                                    class="action-button">
                                Delete
                            </button>

                        </form>

                    </td>

                </tr>
            }

            </tbody>

        </table>
    }

</div>


<script>

    function editProduct(id)
    {
        // Hide normal text

        document.getElementById(
            "display-name-" + id
        ).style.display = "none";

        document.getElementById(
            "display-description-" + id
        ).style.display = "none";

        document.getElementById(
            "display-price-" + id
        ).style.display = "none";


        // Show text boxes

        document.getElementById(
            "edit-name-" + id
        ).style.display = "inline-block";

        document.getElementById(
            "edit-description-" + id
        ).style.display = "inline-block";

        document.getElementById(
            "edit-price-" + id
        ).style.display = "inline-block";


        // Hide Edit button

        document.getElementById(
            "edit-button-" + id
        ).style.display = "none";


        // Show Save button

        document.getElementById(
            "update-form-" + id
        ).style.display = "inline";


        // Set initial values

        document.getElementById(
            "form-name-" + id
        ).value =
            document.getElementById(
                "edit-name-" + id
            ).value;


        document.getElementById(
            "form-description-" + id
        ).value =
            document.getElementById(
                "edit-description-" + id
            ).value;


        document.getElementById(
            "form-price-" + id
        ).value =
            document.getElementById(
                "edit-price-" + id
            ).value;


        // Keep hidden form values updated

        document.getElementById(
            "edit-name-" + id
        ).addEventListener("input", function ()
        {
            document.getElementById(
                "form-name-" + id
            ).value = this.value;
        });


        document.getElementById(
            "edit-description-" + id
        ).addEventListener("input", function ()
        {
            document.getElementById(
                "form-description-" + id
            ).value = this.value;
        });


        document.getElementById(
            "edit-price-" + id
        ).addEventListener("input", function ()
        {
            document.getElementById(
                "form-price-" + id
            ).value = this.value;
        });
    }

</script>